{
  "name": "kubling-docs",
  "version": "0.0.1",
  "private": true,
  "description": "Official documentation for Kubling",
  "license": "Apache-2.0",
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=12 <13"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "check:links": "node scripts/check-internal-links.mjs",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
    "check": "npm run check:links && npm run typecheck && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubling-community/kubling-docs.git"
  },
  "bugs": {
    "url": "https://github.com/kubling-community/kubling-docs/issues"
  },
  "homepage": "https://docs.kubling.com",
  "dependencies": {
    "next": "16.3.1",
    "nextra": "4.6.1",
    "nextra-theme-docs": "4.6.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "github-slugger": "2.0.0",
    "postcss": "8.5.26",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  },
  "overrides": {
    "zod": "4.3.6"
  }
}
